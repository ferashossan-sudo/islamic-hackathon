# Copy to .env and fill in your own keys. Never commit .env.
# uv run --env-file .env uvicorn app.main:app --port 8000

# Turn the language models on (off by default: the app then answers by local search only).
LLM_ENABLED=true

# Claude for routing, conversation and verification (the live site): Haiku 4.5 routes and verifies, Sonnet 5.5 talks.
ROUTER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional per-role overrides (defaults are in app/config.py):
# ROUTER_MODEL=claude-haiku-4-5
# CONVERSE_MODEL=claude-sonnet-5-5
# VERIFY_MODEL=claude-haiku-4-5

# Gemini: the automatic backup when Claude fails (or the main provider with ROUTER_PROVIDER=gemini).
GEMINI_API_KEY=
# GEMINI_API_KEY_EVAL=   # optional separate key for evaluation runs

# Safety switches and limits
CONVERSE_ENABLED=true
FRAMING_ENABLED=true
DAILY_COST_CAP_USD=2
CONFIDENCE_MIN=medium
# ROUTER_TIMEOUT_S=12
# ROUTER_RETRY_TIMEOUT_S=8
# CONVERSE_TIMEOUT_S=15

# Optional
APP_ENV=dev
SUGGEST_FORM_URL=
TEAM_EMAIL=
